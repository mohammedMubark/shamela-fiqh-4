# ─────────────────────────────────────────────────────────────────────────────
# shamela-fiqh-4 — متغيرات البيئة (جميعها اختيارية إلا FIQH4_SHAMELA_DIR)
# All variables use the FIQH4_ prefix. Nothing here is a secret.
# ─────────────────────────────────────────────────────────────────────────────

# مجلد تثبيت المكتبة الشاملة 4. يُفتح للقراءة فقط ولا يُكتب فيه أبدًا.
# Root of the Shamela 4 installation. Opened read-only; never written to.
# Windows example:  D:\shamela
# Linux/macOS example: /home/you/shamela
FIQH4_SHAMELA_DIR=

# مجلد فهرس البحث المشتق. يجب أن يكون خارج مجلد الشاملة.
# Derived search index directory. MUST be outside FIQH4_SHAMELA_DIR.
# Default: <os-data-dir>/shamela-fiqh-4/index
FIQH4_INDEX_DIR=

# مجلد التصدير الآمن. كل عمليات الكتابة تقع تحته حصرًا.
# Safe export root. Every write this extension performs stays inside it.
# Default: <os-data-dir>/shamela-fiqh-4/exports
FIQH4_OUTPUT_DIR=

# ملف تجاوزات تصنيف المذاهب (include / exclude / override) بصيغة JSON.
# Madhhab classification overrides file (JSON).
# Default: <repo>/config/madhhab-overrides.json
FIQH4_OVERRIDES_FILE=

# مسار jar جسر Lucene. اتركه فارغًا لاستخدام محرك Node الافتراضي.
# Path to the locally built Lucene bridge jar. Leave empty to use the Node engine.
# Build it yourself with:  npm run java:build
FIQH4_LUCENE_JAR=

# مسار تنفيذي Java (يُستخدم فقط مع FIQH4_LUCENE_JAR).
# Java executable (only used together with FIQH4_LUCENE_JAR). Default: "java" on PATH.
FIQH4_JAVA_BIN=

# الحد الأقصى لعدد النتائج في استجابة MCP تفاعلية واحدة (1..500).
# Max hits returned in a single interactive MCP response (1..500). Default: 50
FIQH4_MAX_RESULTS_PER_RESPONSE=50

# حد حجم الاستجابة بالبايت قبل الاقتطاع المُعلن (>=16384).
# Response byte budget before an *announced* truncation (>=16384). Default: 262144
FIQH4_MAX_RESPONSE_BYTES=262144

# عدد الكتب المفحوصة على التوازي أثناء التصدير الكامل (1..16).
# Bounded concurrency for full exports (1..16). Default: 4
FIQH4_CONCURRENCY=4

# مستوى السجل على stderr: silent | error | warn | info | debug
# Log level on stderr (stdout is reserved for the MCP protocol). Default: warn
FIQH4_LOG_LEVEL=warn
